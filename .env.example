# Copy this file to .env and adjust as needed. Never commit the real .env.
# Never place real credentials in seed data or this file.

# ---- App ----
APP_ENV=local

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Web ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Database ----
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis:aegis_dev_password@db:5432/aegis

# ---- Local LLM runtime (wired starting Day 6) ----
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Sandbox (wired starting Day 32-33) ----
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1.0

# ---- Agent runtime (wired starting Day 25) ----
MAX_AGENT_RETRIES=3
MAX_RETRIEVAL_K=20

# ---- Observability (wired starting Day 48) ----
LOG_LEVEL=INFO
OTEL_ENDPOINT=http://otel-collector:4317
